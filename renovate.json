{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":maintainLockFilesWeekly",
    "security:minimumReleaseAgeNpm"
  ],
  "customDatasources": {
    "archlinux": {
      "defaultRegistryUrlTemplate": "https://archlinux.org/packages/search/json/?name={{{ packageName }}}",
      "transformTemplates": [
        "{'releases':$.results[].{'version':(epoch?epoch&':':'')&pkgver&'-'&pkgrel,'releaseTimestamp':build_date}}"
      ]
    },
    "bodhi": {
      "defaultRegistryUrlTemplate": "https://bodhi.fedoraproject.org/updates/?packages={{{ packageName }}}",
      "transformTemplates": [
        "{'releases':$.updates[].builds[].{'version':nvr,'releaseTimestamp':%.date_pushed?$replace(%.date_pushed,' ','T')&'Z','isStable':%.status='stable'}}"
      ]
    },
    "github-release-assets": {
      "transformTemplates": [
        "{'releases':$[draft=false].{'version':$replace(tag_name,/^v/,''),'isStable':$not(prerelease),'digest':assets[$contains(name,{{{packageName}}})][0].digest.($?$replace(/^sha256:/,''):undefined),'releaseTimestamp':published_at}}"
      ]
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "*.dockerfile",
        ".github/workflows/code-scan.yml"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(\\s+(lookupName|packageName)=(?<packageName>\\S+))?(\\s+versioning=(?<versioning>\\S+))?(\\s+extractVersion=(?<extractVersion>\\S+))?(\\s+registryUrl=(?<registryUrl>\\S+))?\\n[^\\n:=]*[:=]\\s*[\"']?(?<currentValue>[^\\s\"']+)[\"']?(\\s|$)",
        "#\\s*renovate-digest:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s+currentValue=(?<currentValue>\\S+)(\\s+(lookupName|packageName)=(?<packageName>\\S+))?(\\s+versioning=(?<versioning>\\S+))?(\\s+extractVersion=(?<extractVersion>\\S+))?(\\s+registryUrl=(?<registryUrl>\\S+))?\\n[^\\n:=]*[:=]\\s*[\"']?(?<currentDigest>[^\\s\"']+)[\"']?(\\s|$)"
      ]
    }
  ],
  "packageRules": [
    {
      "matchFileNames": [
        "*.dockerfile"
      ],
      "groupName": "Image dependencies",
      "separateMajorMinor": false,
      "extends": [
        ":automergeAll",
        "schedule:automergeDaily"
      ]
    },
    {
      "matchDatasources": [
        "rpm",
        "custom.archlinux",
        "custom.bodhi"
      ],
      "versioning": "rpm"
    },
    {
      "matchDatasources": [
        "rpm"
      ],
      "matchFileNames": [
        "almalinux-10.dockerfile"
      ],
      "registryUrls": [
        "https://repo.almalinux.org/almalinux/10/AppStream/x86_64/os/repodata/"
      ]
    },
    {
      "matchDatasources": [
        "rpm"
      ],
      "matchFileNames": [
        "centos-10.dockerfile"
      ],
      "registryUrls": [
        "https://mirror.stream.centos.org/10-stream/AppStream/x86_64/os/repodata/"
      ]
    },
    {
      "matchDatasources": [
        "deb"
      ],
      "matchFileNames": [
        "ubuntu-24.04.dockerfile"
      ],
      "registryUrls": [
        "http://ftp.ubuntu.com/ubuntu?release=noble&components=main,universe&binaryArch=amd64",
        "http://ftp.ubuntu.com/ubuntu?release=noble-updates&components=main,universe&binaryArch=amd64"
      ]
    },
    {
      "matchDatasources": [
        "deb"
      ],
      "matchFileNames": [
        "ubuntu-26.04.dockerfile"
      ],
      "registryUrls": [
        "http://ftp.ubuntu.com/ubuntu?release=resolute&components=main,universe&binaryArch=amd64",
        "http://ftp.ubuntu.com/ubuntu?release=resolute-updates&components=main,universe&binaryArch=amd64"
      ]
    },
    {
      "matchDatasources": [
        "apk"
      ],
      "matchFileNames": [
        "alpine-3.24.dockerfile"
      ],
      "registryUrls": [
        "https://dl-cdn.alpinelinux.org/alpine?branch=v3.24&components=community&arch=x86_64"
      ]
    },
    {
      "matchDatasources": [
        "apk"
      ],
      "matchFileNames": [
        "alpine-edge.dockerfile"
      ],
      "registryUrls": [
        "https://dl-cdn.alpinelinux.org/alpine?branch=edge&components=community&arch=x86_64"
      ]
    },
    {
      "extends": [
        "helpers:pinGitHubActionDigests",
        ":pinVersions"
      ],
      "versioning": "npm"
    },
    {
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["action", "workflow"],
      "matchUpdateTypes": ["major", "minor", "patch"],
      "automerge": true,
      "minimumReleaseAge": "3 days"
    }
  ],
  "hostRules": [
    {
      "matchHost": "archlinux.org",
      "concurrentRequestLimit": 1
    },
    {
      "matchHost": "bodhi.fedoraproject.org",
      "concurrentRequestLimit": 1
    }
  ],
  "dockerfile": {
    "enabled": false
  },
  "logLevelRemap": [
    {
      "matchMessage": "No dependencies found in file for custom regex manager",
      "newLogLevel": "warn"
    },
    {
      "matchMessage": "Found no results from datasource that look like a version",
      "newLogLevel": "warn"
    }
  ]
}
